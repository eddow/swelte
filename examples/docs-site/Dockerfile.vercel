# Manual Vercel prebuilt deploy for docs-site (Swelte: V binary + dist/).
# Vercel builds THIS file in the cloud from uploaded LOCAL dist/ output —
# no Node, no V toolchain, no zig in the cloud. Build locally first:
#
#   npm run build:vercel     # swelte build → linux/amd64 from package.json
#   vercel deploy            # preview URL
#   vercel deploy --prod     # production
#
# The `swelte.targetOs/targetArch` in package.json is the deploy target:
# `@swelte/vvm` postinstall preps the machine on `npm i` (zig +
# zig-cc-linux-amd64 wrapper), and plain `swelte build` reads it — no
# flags needed. `npm run build:local` (`swelte build --local`) forces a
# host-native build for local preview, ignoring the declaration.
# Vercel project settings (dashboard → project → Settings):
#   Root Directory: examples/docs-site
#   Dockerfile Path: Dockerfile.vercel  (default when only one Dockerfile.* exists)
#
# Notes:
# - `dist/` is gitignored but MUST be in the upload context: `.vercelignore`
#   allowlists it explicitly (Vercel excludes gitignored output by default).
# - `.dockerignore` excludes everything except dist/ + this Dockerfile —
#   the context stays small and no source/toolchain leaks in.
# - SSR is embedded QuickJS: SWELTE_SSR=1 reads dist/ssr/render.js in-process.
# - $PORT is injected by the platform — the default (8131) only applies
#   to local `docker run` without -e PORT. No EXPOSE needed for Vercel
#   (kept for `docker run`).
# - glibc floor: zig targets x86_64-linux-gnu; the debian:stable-slim
#   runtime must be >= the glibc zig links against (bookworm/slim is fine).

FROM debian:stable-slim
WORKDIR /app
COPY dist ./dist
EXPOSE 8131
ENV PORT=8131 SWELTE_DIST=dist SWELTE_SSR=1
CMD ["./dist/server"]
