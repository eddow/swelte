{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    // Trick for *.test.ts / *.spec.ts importing `node:*`: keep `node` listed
    // so editors resolving a test file against this app config still see
    // @types/node (types-only, never bundled). Node-run tests live under
    // tests/ and are typechecked by tsconfig.test.json.
    "types": [
      "vite/client",
      "svelte",
      "node"
    ],
    "paths": {
      "#routes/*.v": [
        "./.swelte/types/routes/*.d.ts"
      ],
      "#lib/*.v": [
        "./.swelte/types/lib/*.d.ts"
      ],
      "#routes/*": [
        "./src/routes/*"
      ],
      "#lib/*": [
        "./src/lib/*"
      ],
      "$app/*": [
        "./.swelte/app/*"
      ],
      "#app/*": [
        "./.swelte/app/*",
        "./.swelte/*.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    ".swelte/types",
    ".swelte/v-shim.d.ts",
    ".swelte/app/*.d.ts",
    ".swelte/paths.d.ts",
    ".swelte/environment.d.ts"
  ]
}
