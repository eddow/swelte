{
  "name": "shell",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "swelte dev",
    "build": "swelte build",
    "preview": "swelte preview",
    "check": "swelte check",
    "test:integration": "npm run build && npm run test:regression",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test --test-reporter=spec \"dist-test/**/*.test.js\"",
    "test:regression": "node --test --test-concurrency=1 tests/agent.integration.mjs tests/browser.cdp.mjs tests/browser.lifecycle.mjs tests/recovery.integration.mjs tests/select.integration.mjs",
    "test:reload": "node tests/dev-reload.mjs",
    "test:live": "node tests/live-usability.mjs && node tests/browser.live.mjs"
  },
  "dependencies": {
    "@docvia/markdown": "^3.0.0",
    "@swelte/ai": "^0.2.0",
    "@swelte/core": "^0.2.0",
    "@swelte/plus": "^0.2.0",
    "@swelte/ssr-qjs": "^0.2.0",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "svelte": "^5.0.0",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@swelte/vvm": "^0.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "daisyui": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
