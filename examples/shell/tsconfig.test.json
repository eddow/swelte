{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist-test",
		"rootDir": ".",
		"noEmit": false,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		// Trick for *.test.ts / *.spec.ts: `node` must be listed explicitly,
		// otherwise `types` inherited from an app config (vite/client+svelte
		// or an empty default) hides @types/node and `node:*` imports fail
		// with TS2307.
		"types": ["node"]
	},
	"include": ["tests/**/*.test.ts", "tests/**/*.spec.ts", "src/lib/*.ts"]
}
