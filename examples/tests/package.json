{
  "name": "tests",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "swelte dev",
    "build": "swelte build",
    "preview": "swelte preview",
    "test": "swelte test",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:e2e": "SERVE=direct node --test --test-reporter=spec \"tests/e2e/preview.test.js\" && SERVE=preview node --test --test-reporter=spec \"tests/e2e/preview.test.js\"",
    "test:e2e:dev": "node --test --test-reporter=spec \"tests/e2e/dev.test.js\"",
    "test:e2e:preview": "SERVE=direct node --test --test-reporter=spec \"tests/e2e/preview.test.js\" && SERVE=preview node --test --test-reporter=spec \"tests/e2e/preview.test.js\"",
    "test:e2e:all": "npm run test:e2e:preview && npm run test:e2e:dev",
    "test:full": "npm test && npm run build && npm run test:unit && npm run test:e2e:all",
    "test:ssr": "swelte-ssr check"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "@swelte/core": "^0.1.2",
    "@swelte/plus": "^0.1.2",
    "@swelte/ssr-qjs": "^0.1.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "@swelte/vvm": "^0.1.2"
  }
}
