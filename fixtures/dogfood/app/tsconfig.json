{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "$app/*": [
        "./.swelte/app/*"
      ]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "contract.ts",
    ".swelte/v-shim.d.ts",
    "src/**/*.svelte"
  ]
}
