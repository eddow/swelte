{
  "name": "@swelte-dogfood/sample-lib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["package", "src/lib/**/*.v"],
  "svelte": "./package/index.js",
  "types": "./package/index.d.ts",
  "peerDependencies": { "svelte": "^5.0.0" },
  "scripts": {
    "build": "swelte build",
    "package": "swelte package"
  },
  "exports": {
    ".": { "types": "./package/index.d.ts", "svelte": "./package/index.js" },
    "./package.json": "./package.json",
    "./Panel.svelte": {
      "types": "./package/Panel.svelte.d.ts",
      "svelte": "./package/Panel.svelte"
    },
    "./v/text.v": { "types": "./package/text.d.ts" },
    "./v/runner.v": { "default": "./src/lib/backend/runner/api.v" }
  },
  "swelte": {
    "v": {
      "exports": {
        "./runner.v": {
          "source": "./src/lib/backend/runner",
          "entry": "./src/lib/backend/runner/api.v",
          "target": "server"
        },
        "./text.v": {
          "source": "./src/lib/text",
          "entry": "./src/lib/text/api.v",
          "target": "universal"
        }
      }
    }
  }
}
