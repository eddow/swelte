{
  "name": "swelte-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.4",
  "workspaces": [
    "engine/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=examples/something",
    "build": "npm run build --workspace=examples/something",
    "build:engine": "npm run build --workspace=@swelte/core",
    "test": "npm run test:unit && npm run test:install && npm run test:dogfood && npm run test:examples",
    "test:unit": "npm run test --workspace=@swelte/core",
    "test:examples": "npm run test:full --workspace=examples/tests",
    "test:install": "node scripts/test-install.mjs",
    "test:dogfood": "node scripts/test-dogfood.mjs",
    "prepare:dogfood": "npm run build:lib --prefix fixtures/dogfood/sample-lib && npm install --prefix fixtures/dogfood/app --ignore-scripts --offline --no-audit --no-fund --package-lock=false",
    "test:postgres": "node scripts/test-postgres.mjs",
    "measure:dogfood": "node scripts/measure-dogfood.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:patch": "node scripts/sync-version.mjs patch",
    "version:minor": "node scripts/sync-version.mjs minor",
    "version:major": "node scripts/sync-version.mjs major",
    "biome:check": "biome check .",
    "biome": "biome check --write .",
    "biome:unsafe": "biome check --write . --unsafe"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@sveltejs/package": "^2.5.8",
    "typescript": "^5.0.0"
  }
}
