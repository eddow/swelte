// Node-only scaffolder tests (same note as tsconfig.json about `types`).
// Trick for *.test.ts / *.spec.ts importing `node:*`: `types: ["node"]`
// must stay explicit, otherwise @types/node is hidden and `node:*` imports
// fail with TS2307. `src/**/*.ts` already covers specs co-located in src.
{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist-test",
		"rootDir": "src",
		"types": ["node"],
		"noEmit": false,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false
	},
	"include": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.ts"]
}

