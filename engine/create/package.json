{
  "name": "@swelte/create",
  "version": "0.1.5",
  "description": "Scaffold a new Swelte project — npm create @swelte (app or library, SPA or SSR).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./scaffold": "./dist/scaffold.js"
  },
  "bin": {
    "create-@swelte": "bin/create.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "LICENSE-MIT",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test --test-reporter=spec \"dist-test/**/*.test.js\"",
    "pretest": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": {
    "name": "François Marie De Mey",
    "email": "fmdm@emedware.dev",
    "url": "https://github.com/eddow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddow/swelte.git"
  },
  "homepage": "https://github.com/eddow/swelte",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "swelte",
    "svelte",
    "scaffold",
    "create",
    "vlang",
    "vite"
  ]
}
