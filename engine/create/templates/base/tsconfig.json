{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // Trick for *.test.ts / *.spec.ts importing `node:*`: keep `node` listed
    // so editors resolving a test file against this app config still see
    // @types/node (types-only, never bundled).
    "types": ["vite/client", "svelte", "node"],
    "paths": {
      "#routes/*.v": ["./.swelte/types/routes/*.d.ts"],
      "#lib/*.v": ["./.swelte/types/lib/*.d.ts"],
      "#routes/*": ["./src/routes/*"],
      "#lib/*": ["./src/lib/*"],
      "$app/*": ["./.swelte/app/*"],
      "#app/*": ["./.swelte/app/*", "./.swelte/*.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts", ".swelte/types", ".swelte/v-shim.d.ts", ".swelte/app/*.d.ts", ".swelte/paths.d.ts", ".swelte/environment.d.ts"]
}
