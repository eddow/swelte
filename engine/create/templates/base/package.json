{
  "name": "__NAME__",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "swelte dev",
    "build": "swelte build",
    "build:local": "swelte build --local",
    "preview": "swelte preview",
    "check": "swelte check",
    "postinstall": "npm-skills extract --skip-production --override",
    "package": "swelte package"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "@swelte/core": "^__SWELTE_VERSION_core__"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "@swelte/vvm": "^__SWELTE_VERSION_vvm__",
    "npm-skills": "^0.5.1"
  },
  "allowScripts": {
    "@swelte/vvm": true,
    "esbuild": true
  },
  "npmSkills": {
    "consume": {
      "only": [
        "@swelte/*"
      ]
    }
  },
  "files": [
    "package",
    "src/lib/**/*.v"
  ],
  "exports": {
    ".": {
      "types": "./package/index.d.ts",
      "svelte": "./package/index.js",
      "default": "./package/index.js"
    },
    "./package.json": "./package.json"
  },
  "svelte": "./package/index.js"
}
