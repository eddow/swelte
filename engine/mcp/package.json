{
  "name": "@swelte/mcp",
  "version": "0.1.0",
  "description": "Swelte MCP server — route tree, type contracts, and diagnostics for IDE agents (stdio).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "swelte-mcp": "./bin/swelte-mcp.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test --test-reporter=spec \"dist-test/**/*.test.js\"",
    "pretest": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@swelte/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
