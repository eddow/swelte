{
  "name": "@swelte/ssr-qjs",
  "version": "0.1.1",
  "description": "Swelte SSR adapter: embedded QuickJS engine (default). Re-exports @swelte/core and adds build + runtime SSR.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "swelte-ssr": "./bin/swelte-ssr.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./dev": "./dist/dev.js",
    "./cli": "./dist/cli.js",
    "./qjs": "./dist/qjs.js"
  },
  "files": [
    "README.md",
    "dist",
    "bin",
    "c",
    "shims",
    "LICENSE-MIT",
    "package.json",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test --test-force-exit --test-reporter=spec \"dist-test/**/*.test.js\"",
    "pretest": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build",
    "prepack": "npm-skills refs materialize",
    "postpack": "npm-skills refs restore"
  },
  "peerDependencies": {
    "@swelte/core": "^0.1.1",
    "svelte": "^5.0.0",
    "vite": "^6.0.0",
    "rollup": "^4.0.0"
  },
  "dependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "npm-skills": "^0.5.1"
  },
  "license": "MIT",
  "author": {
    "name": "François Marie De Mey",
    "email": "fmdm@emedware.dev",
    "url": "https://github.com/eddow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddow/swelte.git"
  },
  "homepage": "https://github.com/eddow/swelte",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "svelte",
    "ssr",
    "quickjs",
    "vite"
  ],
  "npmSkills": {
    "publish": {
      "source": "skills",
      "export": [
        "swelte-ssr-load"
      ]
    }
  }
}
