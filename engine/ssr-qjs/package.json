{
  "name": "@swelte/ssr-qjs",
  "version": "0.1.0",
  "description": "Swelte SSR adapter: embedded QuickJS engine (default). Re-exports @swelte/core and adds build + runtime SSR.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./dev": "./dist/dev.js",
    "./cli": "./dist/cli.js",
    "./qjs": "./dist/qjs.js"
  },
  "files": ["dist", "c", "shims"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test --test-force-exit --test-reporter=spec \"dist-test/**/*.test.js\"",
    "pretest": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@swelte/core": "^0.1.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0",
    "rollup": "^4.0.0"
  },
  "dependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "license": "MIT"
}
