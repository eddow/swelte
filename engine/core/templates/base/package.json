{
  "name": "__NAME__",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "swelte dev",
    "build": "swelte build",
    "preview": "swelte preview",
    "check": "swelte check",
    "postinstall": "npm-skills extract --skip-production --override"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "@swelte/core": "^__SWELTE_VERSION__"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "@swelte/vvm": "^__SWELTE_VERSION__",
    "npm-skills": "^0.5.1"
  },
  "allowScripts": {
    "@swelte/vvm": true,
    "esbuild": true
  },
  "npmSkills": {
    "consume": {
      "only": [
        "@swelte/*"
      ]
    }
  }
}
