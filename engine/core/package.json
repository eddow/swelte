{
  "name": "@swelte/core",
  "version": "0.1.0",
  "description": "Swelte framework core \u2014 V + Svelte unified RPC bridge (Vite plugin, SDK generator, CLI)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./cli": "./dist/cli.js",
    "./config": "./dist/gen/config.js",
    "./toolchain": "./dist/toolchain.js"
  },
  "bin": {
    "swelte": "./bin/swelte.js"
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test --test-reporter=spec \"dist-test/**/*.test.js\"",
    "pretest": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@swelte/vvm": "^0.1.0"
  },
  "typesVersions": {
    "*": {
      "cli": [
        "./dist/cli.d.ts"
      ],
      "vite": [
        "./dist/vite.d.ts"
      ],
      "config": [
        "./dist/gen/config.d.ts"
      ],
      "toolchain": [
        "./dist/toolchain.d.ts"
      ]
    }
  }
}
