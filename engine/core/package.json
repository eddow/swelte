{
  "name": "@swelte/core",
  "version": "0.1.2",
  "description": "Swelte framework core — V + Svelte unified RPC bridge (Vite plugin, SDK generator, CLI)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./cli": "./dist/cli.js",
    "./config": "./dist/gen/config.js",
    "./diagnostics": "./dist/gen/diagnostics.js",
    "./toolchain": "./dist/toolchain.js"
  },
  "bin": {
    "swelte": "./bin/swelte.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "LICENSE-MIT",
    "package.json",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test --test-reporter=spec \"dist-test/**/*.test.js\"",
    "pretest": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build",
    "prepack": "npm-skills refs materialize",
    "postpack": "npm-skills refs restore"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "npm-skills": "^0.5.1"
  },
  "dependencies": {
    "@swelte/vvm": "^0.1.2"
  },
  "typesVersions": {
    "*": {
      "cli": [
        "./dist/cli.d.ts"
      ],
      "vite": [
        "./dist/vite.d.ts"
      ],
      "config": [
        "./dist/gen/config.d.ts"
      ],
      "diagnostics": [
        "./dist/gen/diagnostics.d.ts"
      ],
      "toolchain": [
        "./dist/toolchain.d.ts"
      ]
    }
  },
  "author": {
    "name": "François Marie De Mey",
    "email": "fmdm@emedware.dev",
    "url": "https://github.com/eddow"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddow/swelte.git"
  },
  "homepage": "https://github.com/eddow/swelte",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vlang",
    "svelte",
    "sveltekit",
    "vite",
    "rpc",
    "wasm",
    "fullstack"
  ],
  "npmSkills": {
    "publish": {
      "source": "skills",
      "export": [
        "swelte-overview",
        "swelte-svelte5",
        "swelte-sveltekit-delta",
        "swelte-v-routes"
      ]
    }
  }
}
