{
	"name": "@swelte/ai",
	"version": "0.2.0",
	"description": "Swelte AI sessions — typed runs, progressive state, adapters, tools and traces over Swelte transport.",
	"type": "module",
	"main": "./package/index.js",
	"types": "./package/index.d.ts",
	"svelte": "./package/index.js",
	"exports": {
		".": {
			"types": "./package/index.d.ts",
			"default": "./package/index.js"
		},
		"./tools": "./package/tools.js",
		"./package.json": "./package.json",
		"./media": "./package/media.js",
		"./openrouter": "./package/openrouter.js",
		"./openai": "./package/openai.js",
		"./anthropic": "./package/anthropic.js"
	},
	"files": [
		"README.md",
		"package",
		"src/lib/**/*.v",
		"LICENSE-MIT",
		"package.json"
	],
	"scripts": {
		"dev": "swelte dev",
		"build": "swelte build",
		"build:local": "swelte build --local",
		"preview": "swelte preview",
		"check": "swelte check",
		"package": "swelte package",
		"pretest": "tsc -p tsconfig.test.json",
		"test": "node --test --test-reporter=spec \"dist-test/**/*.test.js\"",
		"prepublishOnly": "npm run package"
	},
	"peerDependencies": {
		"@swelte/media": "^0.2.0",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@swelte/media": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@swelte/core": "^0.2.0",
		"@swelte/vvm": "^0.2.0",
		"@types/node": "^26.6.6",
		"npm-skills": "^0.5.1",
		"svelte": "^5.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0"
	},
	"license": "MIT",
	"author": {
		"name": "François Marie De Mey",
		"email": "fmdm@emedware.dev",
		"url": "https://github.com/eddow"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eddow/swelte.git"
	},
	"homepage": "https://github.com/eddow/swelte",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"swelte",
		"ai",
		"agents",
		"streaming"
	]
}
